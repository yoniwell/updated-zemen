NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://zemensacco.com,https://www.zemensacco.com
API_RATE_LIMIT_MAX=1200

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
OTP_SECRET=
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=.zemensacco.com
ADMIN_INVITE_BASE_URL=https://zemensacco.com/admin/login

DATABASE_URL=mysql://zemensjf_zemensjf:6hqxk7MR%5B%28955C%21F%28@localhost:3306/zemensjf_db?connection_limit=1&pool_timeout=30
POSTGRES_MIGRATION_URL=
MYSQL_MIGRATION_URL=mysql://zemensjf_zemensjf:6hqxk7MR%5B%28955C%21F%28@localhost:3306/zemensjf_db?connection_limit=1&pool_timeout=30
PRISMA_CONNECTION_LIMIT=1
PRISMA_POOL_TIMEOUT_SECONDS=30

UPLOAD_DIR=./uploads
MALWARE_SCAN_COMMAND=

EMAIL_ENABLED=false
EMAIL_USER=no-reply@zemensacco.com
EMAIL_PASS=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FROM_NAME=Zemen Sacco
EMAIL_FROM_ADDRESS=no-reply@zemensacco.com

BACKGROUND_QUEUE_ENABLED=false
BACKGROUND_QUEUE_POLL_MS=15000
BACKGROUND_QUEUE_PAUSE_MS=600000
DATA_RETENTION_INTERVAL_MINUTES=1440
NOTIFICATION_RETENTION_DAYS=180
SECURITY_EVENT_RETENTION_DAYS=30
AUTH_SESSION_RETENTION_DAYS=90
ENABLE_INQUIRY_ROUTING=true

AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_EXPORT_MAX_ROWS=5000
AUDIT_EXPORT_SIGNING_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
AUDIT_INTEGRITY_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
AUDIT_INTEGRITY_VERIFY_ENABLED=true
AUDIT_INTEGRITY_VERIFY_INTERVAL_MINUTES=60

MIGRATION_TABLES=
MIGRATION_EXCLUDE_TABLES=_prisma_migrations
MIGRATION_CHUNK_SIZE=1000
MIGRATION_TRUNCATE_TARGET=false
MIGRATION_UPSERT=true
MIGRATION_STOP_ON_ERROR=true
MIGRATION_DRY_RUN=false
MIGRATION_FAIL_ON_MISMATCH=true
ALLOW_DESTRUCTIVE_MIGRATION=false

MYSQL_BASELINE_SQL_PATH=
MYSQL_BASELINE_MIGRATION_ID=
MYSQL_BASELINE_FORCE=false
