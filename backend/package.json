{
  "name": "zemen-sacco-server",
  "version": "1.0.0",
  "description": "Zemen SACCO Digital Platform - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:deploy": "npm run db:generate && npm run build",
    "test": "tsx --test src/**/*.test.ts",
    "test:smoke": "tsx --test src/routes/admin.integration.test.ts src/routes/settings.integration.test.ts",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:apply:mysql-baseline": "tsx scripts/apply-mysql-baseline.ts",
    "db:verify:mysql-baseline": "tsx scripts/verify-mysql-baseline.ts",
    "db:migrate:pg-to-mysql": "tsx scripts/migrate-pg-to-mysql.ts",
    "db:verify:pg-mysql-parity": "tsx scripts/verify-pg-mysql-parity.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "mysql2": "^3.20.0",
    "pg": "^8.20.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
