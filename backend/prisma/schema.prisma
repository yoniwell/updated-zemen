generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                     String                  @id @default(uuid())
  name                   String                  @unique
  code                   String                  @unique
  location               String
  manager                String?
  status                 String                  @default("OPERATIONAL")
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  mapUrl                 String?
  officeHours            String?
  phonePrimary           String?
  phoneSecondary         String?
  published              Boolean                 @default(true)
  adminUsers             AdminUser[]
  loanApplications       LoanApplication[]
  membershipApplications MembershipApplication[]

  @@map("branches")
}

model Applicant {
  id                     String                  @id @default(uuid())
  firstName              String
  fathersName            String?
  grandfathersName       String?
  phone                  String                  @unique
  email                  String?
  idType                 String?
  idNumber               String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  loanApplications       LoanApplication[]
  membershipApplications MembershipApplication[]

  @@map("applicants")
}

model MembershipApplication {
  id                      String            @id @default(uuid())
  referenceNo             String            @unique
  applicantId             String
  applicantType           ApplicantType     @default(INDIVIDUAL)
  status                  ApplicationStatus @default(SUBMITTED)
  branchId                String?
  termsAccepted           Boolean           @default(false)
  assignedToId            String?
  submittedAt             DateTime?
  reviewedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  membershipPaymentAmount Float?
  savingPaymentAmount     Float?
  savingTransactionRef    String?
  savingType              String?
  notes                   ApplicationNote[]
  documents               Document[]
  applicant               Applicant         @relation(fields: [applicantId], references: [id])
  assignedTo              AdminUser?        @relation("MembershipAssigned", fields: [assignedToId], references: [id])
  branch                  Branch?           @relation(fields: [branchId], references: [id])
  workflow                WorkflowHistory[]

  @@index([branchId, status, createdAt])
  @@index([assignedToId, status, createdAt])
  @@index([applicantId])
  @@map("membership_applications")
}

model LoanApplication {
  id             String            @id @default(uuid())
  referenceNo    String            @unique
  applicantId    String
  membershipNo   String?
  status         ApplicationStatus @default(SUBMITTED)
  loanType       String?
  amount         Float?
  tenure         Int?
  collateralType String?
  collateralDesc String?
  branchId       String?
  termsAccepted  Boolean           @default(false)
  assignedToId   String?
  submittedAt    DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  idType         String?
  maritalStatus  String?
  notes          ApplicationNote[]
  documents      Document[]
  applicant      Applicant         @relation(fields: [applicantId], references: [id])
  assignedTo     AdminUser?        @relation("LoanAssigned", fields: [assignedToId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  workflow       WorkflowHistory[]

  @@index([branchId, status, createdAt])
  @@index([loanType, status, createdAt])
  @@index([assignedToId, status, createdAt])
  @@index([applicantId])
  @@map("loan_applications")
}

model Document {
  id                      String                 @id @default(uuid())
  category                DocumentCategory
  originalName            String
  storedName              String
  mimeType                String
  size                    Int
  status                  DocumentStatus         @default(PENDING)
  membershipApplicationId String?
  loanApplicationId       String?
  uploadedAt              DateTime               @default(now())
  verifiedAt              DateTime?
  verifiedById            String?
  rejectionReason         String?
  loanApplication         LoanApplication?       @relation(fields: [loanApplicationId], references: [id])
  membershipApplication   MembershipApplication? @relation(fields: [membershipApplicationId], references: [id])
  verifiedBy              AdminUser?             @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@index([status, uploadedAt])
  @@index([membershipApplicationId, status])
  @@index([loanApplicationId, status])
  @@index([verifiedById])
  @@map("documents")
}

model AdminUser {
  id                  String                  @id @default(uuid())
  name                String
  email               String                  @unique
  passwordHash        String
  role                AdminRole               @default(OFFICER)
  branchId            String?
  isActive            Boolean                 @default(true)
  lastLogin           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  branch              Branch?                 @relation(fields: [branchId], references: [id])
  notes               ApplicationNote[]
  auditLogs           AuditLog[]
  authSessions        AuthSession[]
  verifiedDocuments   Document[]              @relation("DocumentVerifier")
  assignedLoans       LoanApplication[]       @relation("LoanAssigned")
  assignedMemberships MembershipApplication[] @relation("MembershipAssigned")
  workflowActions     WorkflowHistory[]

  @@index([role, isActive, branchId])
  @@index([lastLogin])
  @@index([branchId])
  @@map("admin_users")
}

model ApplicationNote {
  id                      String                 @id @default(uuid())
  content                 String
  isInternal              Boolean                @default(true)
  authorId                String
  membershipApplicationId String?
  loanApplicationId       String?
  createdAt               DateTime               @default(now())
  author                  AdminUser              @relation(fields: [authorId], references: [id])
  loanApplication         LoanApplication?       @relation(fields: [loanApplicationId], references: [id])
  membershipApplication   MembershipApplication? @relation(fields: [membershipApplicationId], references: [id])

  @@index([authorId])
  @@index([loanApplicationId])
  @@index([membershipApplicationId])
  @@map("application_notes")
}

model WorkflowHistory {
  id                      String                 @id @default(uuid())
  fromStatus              ApplicationStatus
  toStatus                ApplicationStatus
  note                    String?
  changedById             String
  membershipApplicationId String?
  loanApplicationId       String?
  createdAt               DateTime               @default(now())
  changedBy               AdminUser              @relation(fields: [changedById], references: [id])
  loanApplication         LoanApplication?       @relation(fields: [loanApplicationId], references: [id])
  membershipApplication   MembershipApplication? @relation(fields: [membershipApplicationId], references: [id])

  @@index([fromStatus, toStatus, createdAt])
  @@index([changedById, createdAt])
  @@index([membershipApplicationId, createdAt])
  @@index([loanApplicationId, createdAt])
  @@map("workflow_history")
}

model AuditLog {
  id         String     @id @default(uuid())
  userId     String?
  action     String
  targetType String
  targetId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime   @default(now())
  user       AdminUser? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, createdAt])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model CmsFaq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_faqs")
}

model News {
  id          String    @id @default(uuid())
  title       String
  excerpt     String
  content     String?
  imageUrl    String?
  category    String    @default("General")
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@map("news")
}

model NotificationEvent {
  id        String   @id @default(uuid())
  status    String   @default("INFO")
  title     String
  recipient String
  type      String   @default("SYSTEM")
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([type, timestamp])
  @@index([status, createdAt])
  @@map("notification_events")
}

model DownloadCategory {
  id        String         @id @default(uuid())
  name      String
  sortOrder Int            @default(0)
  published Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  files     DownloadFile[]

  @@map("download_categories")
}

model DownloadFile {
  id         String           @id @default(uuid())
  categoryId String
  name       String
  fileSize   String
  fileType   String
  fileUrl    String
  published  Boolean          @default(true)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  category   DownloadCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, published, sortOrder])
  @@map("download_files")
}

model CmsService {
  id          String   @id @default(uuid())
  title       String
  description String
  features    Json
  ctaLabel    String?
  ctaPath     String?
  sortOrder   Int      @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_services")
}

model CmsSaving {
  id          String   @id @default(uuid())
  title       String
  description String
  features    Json
  ctaLabel    String?
  ctaPath     String?
  sortOrder   Int      @default(0)
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cms_savings")
}

model CmsLoanProduct {
  id           String   @id @default(uuid())
  name         String
  purpose      String
  suited       String
  docs         String
  status       String   @default("DRAFT")
  maxAmount    String
  interestRate String
  maxTerm      String
  color        String   @default("border-l-primary")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cms_loan_products")
}

model CmsAnnouncement {
  id        String    @id @default(uuid())
  title     String
  content   String
  type      String    @default("Info")
  status    String    @default("Scheduled")
  startDate DateTime
  endDate   DateTime?
  placement String    @default("Banner")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("cms_announcements")
}

model SecurityEventLog {
  id        String   @id @default(uuid())
  endpoint  String
  eventType String
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  @@index([endpoint, createdAt])
  @@index([eventType, createdAt])
  @@map("security_event_logs")
}

model LoginAbuseState {
  email          String    @id
  failedAttempts Int       @default(0)
  windowStartAt  DateTime?
  lockoutUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("login_abuse_states")
}

model AuthSession {
  tokenId   String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      AdminUser @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt, expiresAt])
  @@map("auth_sessions")
}

model BackgroundJobQueue {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  runAt       DateTime  @default(now()) @map("run_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  finishedAt  DateTime? @map("finished_at")
  lastError   String?   @map("last_error")
  createdBy   String?   @map("created_by")

  @@index([status, runAt])
  @@map("background_job_queue")
}

model OperationalAlert {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("createdAt")
  severity  String
  source    String
  message   String
  requestId String?  @map("requestId")
  details   Json?
  status    String   @default("OPEN")

  @@index([createdAt])
  @@index([status, severity])
  @@map("operational_alerts")
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model SavingTypeConfig {
  id          String   @id @default(uuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  minAmount   Float?   // minimum saving amount in ETB
  maxAmount   Float?   // maximum saving amount in ETB
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("saving_type_configs")
}

model LoanTypeConfig {
  id          String   @id @default(uuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  minAmount   Float?   // minimum loan amount in ETB
  maxAmount   Float?   // maximum loan amount in ETB
  minTenure   Int?     // minimum tenure in months
  maxTenure   Int?     // maximum tenure in months
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("loan_type_configs")
}

enum DocumentCategory {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  PASSPORT
  APPLICANT_PHOTO
  LOAN_APPLICATION_LETTER
  LOAN_REQUEST_FORM
  ID_FRONT_PHOTO
  ID_BACK_PHOTO
  MARRIAGE_CERTIFICATE
  BUSINESS_PLAN
  PERSONAL_PHOTO
  COLLATERAL_DOCUMENT
  FILLED_FORM
  MEMBERSHIP_PAYMENT_PROOF
  SAVING_PAYMENT_PROOF
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  FLAGGED
  EXPIRED
}

enum AdminRole {
  SUPER_ADMIN
  BRANCH_MANAGER
  OFFICER
  CONTENT_MANAGER
}

enum ApplicantType {
  INDIVIDUAL
  GROUP
  ORGANIZATION
}
